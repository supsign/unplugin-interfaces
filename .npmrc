ignore-workspace-root-check=true
shamefully-hoist=true

# Optionale Peers NICHT automatisch mitinstallieren. Ohne das zieht pnpm
# @farmfe/core (optionaler Peer von unplugin) in den Lockfile und damit dessen
# kompletten Dev-Server-Baum -- koa, ws, js-yaml 3.x, http-proxy-middleware.
# Das waren allein rund zwei Drittel aller offenen Dependabot-Alerts, fuer
# Code, den dieses Paket nie ausfuehrt: src/farm.ts importiert nur aus
# 'unplugin'. Wer den Farm-Adapter nutzt, bringt @farmfe/core selbst mit.
auto-install-peers=false
